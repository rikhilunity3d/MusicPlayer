  aartiTitle: Jai Ganesh Deva
  lyrics: "\n\n\u0915\u093E\u092E\u0928\u093E \u0915\u094B \u092A\u0942\u0930\u093E
    \u0915\u0930\u094B \u091C\u0917 \u092C\u0932\u0940 \u0939\u093E\u0930\u0940\n\n\n\n\n\u091C\u092F
    \u0917\u0923\u0947\u0936 \u091C\u092F \u0917\u0923\u0947\u0936 \u091C\u092F \u0917\u0923\u0947\u0936
    \u0926\u0947\u0935\u093E\n\n\n\u091C\u092F \u0917\u0923\u0947\u0936 \u091C\u092F
    \u0917\u0923\u0947\u0936 \u091C\u092F \u0917\u0923\u0947\u0936 \u0926\u0947\u0935\u093E\n\n\n\u092E\u093E\u0924\u093E
    \u091C\u093E\u0915\u0940 \u092A\u093E\u0930\u094D\u0935\u0924\u0940, \u092A\u093F\u0924\u093E
    \u092E\u0939\u093E\u0926\u0947\u0935\u093E"
  aartiAudioClip: {fileID: 8300000, guid: d45eda910bc2d4deb9e086ce7f64c7c1, type: 3}
  syncedLyrics:
  - time: 0.3
    line: "\u091C\u092F \u0917\u0923\u0947\u0936 \u091C\u092F \u0917\u0923\u0947\u0936
      \u091C\u092F \u0917\u0923\u0947\u0936 \u0926\u0947\u0935\u093E"
  - time: 0.41
    line: "\u092E\u093E\u0924\u093E \u091C\u093E\u0915\u0940 \u092A\u093E\u0930\u094D\u0935\u0924\u0940,
      \u092A\u093F\u0924\u093E \u092E\u0939\u093E\u0926\u0947\u0935\u093E"
  - time: 0.51
    line: "\u091C\u092F \u0917\u0923\u0947\u0936, \u091C\u092F \u0917\u0923\u0947\u0936,
      \u091C\u092F \u0917\u0923\u0947\u0936 \u0926\u0947\u0935\u093E"
  - time: 0.56
    line: "\u092E\u093E\u0924\u093E \u091C\u093E\u0915\u0940 \u092A\u093E\u0930\u094D\u0935\u0924\u0940,
      \u092A\u093F\u0924\u093E \u092E\u0939\u093E\u0926\u0947\u0935\u093E"
  - time: 1.16
    line: "\u090F\u0915\u0926\u0902\u0924, \u0926\u092F\u093E\u0935\u0928\u094D\u0924,
      \u091A\u093E\u0930 \u092D\u0941\u091C\u093E\u0927\u093E\u0930\u0940"
  - time: 1.26
    line: "\u092E\u093E\u0925\u0947 \u0938\u093F\u0902\u0926\u0942\u0930 \u0938\u094B\u0939\u0947,
      \u092E\u0942\u0938\u0947 \u0915\u0940 \u0938\u0935\u093E\u0930\u0940"
  - time: 1.36
    line: "\u091C\u092F \u0917\u0923\u0947\u0936 \u091C\u092F \u0917\u0923\u0947\u0936
      \u091C\u092F \u0917\u0923\u0947\u0936 \u0926\u0947\u0935\u093E"
  - time: 1.42
    line: "\u092E\u093E\u0924\u093E \u091C\u093E\u0915\u0940 \u092A\u093E\u0930\u094D\u0935\u0924\u0940,
      \u092A\u093F\u0924\u093E \u092E\u0939\u093E\u0926\u0947\u0935\u093E"
  - time: 1.46
    line: "\u091C\u092F \u0917\u0923\u0947\u0936 \u091C\u092F \u0917\u0923\u0947\u0936
      \u091C\u092F \u0917\u0923\u0947\u0936 \u0926\u0947\u0935\u093E"
  - time: 1.51
    line: "\u092E\u093E\u0924\u093E \u091C\u093E\u0915\u0940 \u092A\u093E\u0930\u094D\u0935\u0924\u0940,
      \u092A\u093F\u0924\u093E \u092E\u0939\u093E\u0926\u0947\u0935\u093E"
  - time: 2.16
    line: "\u092A\u093E\u0928 \u091A\u095D\u0947, \u092B\u0942\u0932 \u091A\u095D\u0947
      \u0914\u0930 \u091A\u095D\u0947 \u092E\u0947\u0935\u093E"
  - time: 2.27
    line: "\u0932\u095C\u0921\u0941\u0905\u0928 \u0915\u093E \u092D\u094B\u0917 \u0932\u0917\u0947,
      \u0938\u0902\u0924 \u0915\u0930\u0947\u0902 \u0938\u0947\u0935\u093E"
  - time: 2.37
    line: "\u091C\u092F \u0917\u0923\u0947\u0936, \u091C\u092F \u0917\u0923\u0947\u0936,
      \u091C\u092F \u0917\u0923\u0947\u0936, \u0926\u0947\u0935\u093E"
  - time: 2.42
    line: "\u092E\u093E\u0924\u093E \u091C\u093E\u0915\u0940 \u092A\u093E\u0930\u094D\u0935\u0924\u0940,
      \u092A\u093F\u0924\u093E \u092E\u0939\u093E\u0926\u0947\u0935\u093E"
  - time: 247
    line: "\u091C\u092F \u0917\u0923\u0947\u0936 \u091C\u092F \u0917\u0923\u0947\u0936
      \u091C\u092F \u0917\u0923\u0947\u0936 \u0926\u0947\u0935\u093E"
  - time: 2.52
    line: "\u092E\u093E\u0924\u093E \u091C\u093E\u0915\u0940 \u092A\u093E\u0930\u094D\u0935\u0924\u0940,
      \u092A\u093F\u0924\u093E \u092E\u0939\u093E\u0926\u0947\u0935\u093E"
  - time: 3.07
    line: "\u0905\u0902\u0927\u0928 \u0915\u094B \u0906\u0902\u0916 \u0926\u0947\u0924,
      \u0915\u094B\u095D\u093F\u0928 \u0915\u094B \u0915\u093E\u092F\u093E"
  - time: 3.17
    line: "\u092C\u093E\u0902\u091D\u0928 \u0915\u094B \u092A\u0941\u0924\u094D\u0930
      \u0926\u0947\u0924, \u0928\u093F\u0930\u094D\u0927\u0928 \u0915\u094B \u092E\u093E\u092F\u093E"
  - time: 3.28
    line: "\u091C\u092F \u0917\u0923\u0947\u0936 \u091C\u092F \u0917\u0923\u0947\u0936
      \u091C\u092F \u0917\u0923\u0947\u0936 \u0926\u0947\u0935\u093E"
  - time: 3.33
    line: "\u092E\u093E\u0924\u093E \u091C\u093E\u0915\u0940 \u092A\u093E\u0930\u094D\u0935\u0924\u0940,
      \u092A\u093F\u0924\u093E \u092E\u0939\u093E\u0926\u0947\u0935\u093E"
  - time: 3.37
    line: "\u091C\u092F \u0917\u0923\u0947\u0936 \u091C\u092F \u0917\u0923\u0947\u0936
      \u091C\u092F \u0917\u0923\u0947\u0936 \u0926\u0947\u0935\u093E"
  - time: 3.42
    line: "\u092E\u093E\u0924\u093E \u091C\u093E\u0915\u0940 \u092A\u093E\u0930\u094D\u0935\u0924\u0940,
      \u092A\u093F\u0924\u093E \u092E\u0939\u093E\u0926\u0947\u0935\u093E"
  - time: 4.07
    line: "\u0938\u0941\u0930 \u0936\u093E\u092E \u0936\u0930\u0923 \u0906\u092F\u0947
      \u0938\u092B\u0932 \u0915\u0940\u091C\u0947 \u0938\u0947\u0935\u093E"
  - time: 4.17
    line: "\u092D\u0915\u094D\u0924\u091C\u0928 \u0924\u094B\u0930\u0947 \u0936\u0930\u0923
      \u0915\u0943\u092A\u093E \u0930\u093E\u0916\u094B \u0926\u0947\u0935\u093E"
